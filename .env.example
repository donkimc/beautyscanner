# Optional: AI-written explanations (DeepSeek). Without it the demo uses template text.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Google login (all three are required for login to work; server-side only).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials and add the redirect URI:
#   <your site origin>/api/auth/google/callback      e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string used to sign the session cookie, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Optional: public site URL. If unset it is derived from the request (works behind Railway's proxy).
# AUTH_URL=https://your-domain.example
