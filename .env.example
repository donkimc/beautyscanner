# --- Required in production ---
# Postgres connection string. On Railway, reference the database service: ${{Postgres.DATABASE_URL}}
# (Without it, local development uses an in-memory database that resets on restart.)
DATABASE_URL=
# Random string that signs session cookies: `openssl rand -base64 32`
AUTH_SECRET=

# --- Email login (confirmation links) ---
# Resend (https://resend.com). EMAIL_FROM must be a sender on a domain you verified in Resend,
# e.g. "BeautyScanner <login@yourdomain.com>". Without these, production refuses email login;
# in development the login link is shown on screen instead of being emailed.
RESEND_API_KEY=
EMAIL_FROM=

# --- Google login (optional; the button is hidden unless all three of these and AUTH_SECRET are set) ---
# Add the redirect URI <site origin>/api/auth/google/callback in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI explanations (optional; template text is used without it) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Optional: public site URL. If unset it is derived from the request (works behind Railway's proxy).
# AUTH_URL=https://your-domain.example

# --- Real product data from Naver Shopping (the admin page) ---
# Create an app at https://developers.naver.com (Application > Register, API: "검색"/Search) to get these.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Comma-separated login emails allowed to open /admin/catalog (everyone else gets a 404).
ADMIN_EMAILS=
# Set to 1 to hide the fictional "[샘플]" products once real products cover every routine step.
# HIDE_SAMPLES=1
# Secret for the daily price refresh: POST /api/cron/refresh-listings with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Only for local testing with `npm run mock:naver`:
# NAVER_API_BASE=http://localhost:4010
# NAVER_IMAGE_HOSTS=localhost

# --- One-off sample pictures (scripts/gen-images.ts; local use only, not needed on the server) ---
# Atlas Cloud key for `npm run gen:images`. Put it in .env.local, never in the repo.
# ATLAS_API_KEY=
